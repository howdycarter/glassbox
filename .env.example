# Meta Model API key for the Model Advisor's Live Model mode.
# Create the key at dev.meta.ai (entrant step — never share it, never
# commit it). Copy this file to .env.local (gitignored) and fill it in:
#   cp .env.example .env.local
# Without a key, Live Model mode serves the disclosed cached outputs —
# the failure ladder working as designed.
VITE_META_MODEL_API_KEY=

# Day-1 spike only (the app build does not read these): the
# one-command smoke check `npm run smoke:live` takes the key from
# META_MODEL_API_KEY in the shell environment and can probe
# alternate API shapes via META_MODEL_API_BASE_URL / META_MODEL_ID
# if the portal disagrees with the documented shape. See
# scripts/smoke-live.ts.
