# Meta Model API key for the Model Advisor's Live Model mode.
# Create the key at dev.meta.ai (entrant step — never share it, never
# commit it). Copy this file to .env.local (gitignored) and fill it in:
#   cp .env.example .env.local
# Without a key, Live Model mode serves the disclosed cached outputs —
# the failure ladder working as designed.
VITE_META_MODEL_API_KEY=
